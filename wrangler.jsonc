{
  "name": "glossquote-csv-workbench",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "csv.glossquote.com", "custom_domain": true }
  ]
}
